<Window x:Class="Snug.Windows.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 Snug" Width="520" Height="590"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI">
    <Grid Margin="30,28,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Border Width="50" Height="50" CornerRadius="16" Background="#29345C"
                    HorizontalAlignment="Left">
                <TextBlock Text="S" FontSize="30" FontWeight="Bold" Foreground="#DDE3FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="欢迎使用 Snug" FontSize="27" FontWeight="SemiBold" Margin="0,22,0,0"/>
            <TextBlock Text="把电脑窗口带到手机屏上。" FontSize="13"
                       Foreground="{StaticResource TextMuted}" Margin="1,7,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <DockPanel>
                    <Border Width="34" Height="34" CornerRadius="11" Background="#29345C">
                        <TextBlock Text="1" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="连接 UU 远程" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="从 iPhone 发起远程连接" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,10,0,0">
                <DockPanel>
                    <Border Width="34" Height="34" CornerRadius="11" Background="#29345C">
                        <TextBlock Text="2" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="选择 Snug Phone" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="在 UU 的屏幕列表中切换到 Snug Phone" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,10,0,0">
                <DockPanel>
                    <Border Width="34" Height="34" CornerRadius="11" Background="#29345C">
                        <TextBlock Text="3" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="点选窗口" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="底部横条可随时返回窗口列表" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="2,20,2,0">
                <StackPanel>
                    <TextBlock Text="虚拟显示驱动" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DriverStatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="安装 / 修复" Click="InstallDriver_Click"
                        IsEnabled="{Binding CanRepairDriver}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="开始使用"
                Click="Start_Click" HorizontalAlignment="Stretch" Padding="16,13"/>
    </Grid>
</Window>