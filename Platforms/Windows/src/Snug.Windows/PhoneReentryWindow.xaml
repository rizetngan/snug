<Window x:Class="Snug.Windows.PhoneReentryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snug · 进入手机屏" Width="158" Height="48"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI">
    <Button x:Name="EnterButton" Click="Enter_Click"
            AutomationProperties.Name="进入手机屏" ToolTip="重新创建 Snug 手机屏"
            Cursor="Hand" Padding="14,0" FontSize="14" FontWeight="SemiBold"
            Foreground="White" Background="#1769E0" BorderThickness="0">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="22"
                        Margin="2,2,2,4" BorderThickness="1" BorderBrush="#0D57C4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.22"/>
                    </Border.Effect>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#0C57C5"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Background" Value="#09469F"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Pill" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Pill" Property="Opacity" Value="0.60"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M 4,2 L 14,2 A 2,2 0 0 1 16,4 L 16,18 A 2,2 0 0 1 14,20 L 4,20 A 2,2 0 0 1 2,18 L 2,4 A 2,2 0 0 1 4,2 M 7,17 L 11,17"
                  Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="14" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
            <TextBlock Text="进入手机屏" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</Window>