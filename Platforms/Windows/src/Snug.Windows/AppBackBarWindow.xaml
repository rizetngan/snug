<Window x:Class="Snug.Windows.AppBackBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" AllowsTransparency="True"
        Background="Transparent" Width="316" Height="52">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Grid.Column="0" Click="Back_Click"
                AutomationProperties.Name="返回窗口列表"
                Background="Transparent" BorderBrush="Transparent"
                BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
            <Border Background="#E6121D30" BorderBrush="#40516F"
                    BorderThickness="1" CornerRadius="14" Padding="10,5">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <TextBlock Text="‹" FontSize="25" Foreground="#DCE5FF"
                               VerticalAlignment="Center" Margin="0,-3,8,0"/>
                    <TextBlock x:Name="AppNameText" Text="App"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#F3F6FC" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Button>
        <StackPanel x:Name="ZoomControls" Grid.Column="1"
                    Orientation="Horizontal" Margin="6,0,0,0"
                    VerticalAlignment="Center" Visibility="Collapsed">
            <Button Content="A−" Width="48" Height="44" Padding="0"
                    Click="ZoomOut_Click" ToolTip="缩小字号"
                    AutomationProperties.Name="缩小当前应用字号"
                    Background="#E6121D30" BorderBrush="#40516F"/>
            <Button Content="A+" Width="48" Height="44" Padding="0"
                    Margin="5,0,0,0" Click="ZoomIn_Click" ToolTip="放大字号"
                    AutomationProperties.Name="放大当前应用字号"
                    Background="#E6121D30" BorderBrush="#40516F"/>
        </StackPanel>
    </Grid>
</Window>
