<Window x:Class="Snug.Windows.HomeBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Background="#111827"
        Foreground="#EAF0FF" FontFamily="Segoe UI Variable Text">
    <Grid Background="#111827">
        <Button Click="ShowList_Click" ToolTip="返回窗口列表"
                Background="Transparent" BorderBrush="Transparent"
                Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Width="108" Height="4" CornerRadius="2"
                    Background="#F4F5F7" HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
        </Button>
    </Grid>
</Window>