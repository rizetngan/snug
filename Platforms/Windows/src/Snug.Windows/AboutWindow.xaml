<Window x:Class="Snug.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 Snug for Windows" Width="520" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PageBackground}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <DockPanel Margin="24">
        <Button DockPanel.Dock="Bottom" Content="关闭" IsCancel="True" HorizontalAlignment="Right" MinWidth="84" Margin="0,18,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="ProductIcon" Width="64" Height="64" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Snug for Windows" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="VersionLabel" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                                <TextBlock Text="手机远程电脑的显示与触控增强" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="在 Snug 原有 macOS 体验基础上新增 Windows 平台支持。" Margin="0,16,0,0" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,9,0,0" FontSize="13">
                            <Hyperlink NavigateUri="https://github.com/rizetngan/snug-for-windows" Foreground="{StaticResource Accent}" RequestNavigate="OpenLink">github.com/rizetngan/snug-for-windows</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Windows 社区独立维护 · rizetngan" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="致谢" FontSize="14" FontWeight="SemiBold" Margin="2,19,0,8"/>
                <Border Style="{StaticResource CardStyle}" Padding="16,12">
                    <StackPanel>
                        <TextBlock FontSize="13"><Hyperlink NavigateUri="https://github.com/zephyr4123/snug" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">zephyr4123</Hyperlink><Run Text=" · Snug 原作者"/></TextBlock>
                        <TextBlock FontSize="13" Margin="0,9,0,0"><Hyperlink NavigateUri="https://github.com/aoyamashou/UUyc-companion" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">UUyc-companion</Hyperlink><Run Text=" · AoyamaShou · 项目前身"/></TextBlock>
                        <TextBlock FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"><Hyperlink NavigateUri="https://github.com/jaywcjlove/PermissionFlow" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">PermissionFlow</Hyperlink><Run Text=" · "/><Hyperlink NavigateUri="https://github.com/pincc-debug/better-remote" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">Better Remote</Hyperlink><Run Text=" · "/><Hyperlink NavigateUri="https://github.com/huberdf/FreeDisplay" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">FreeDisplay</Hyperlink></TextBlock>
                        <TextBlock Text="原项目社区 PR 作者：bubble、gencheng liu、Rongzheng Liu" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Separator Background="{StaticResource PanelBorder}" Margin="0,12"/>
                        <TextBlock Text="Windows 平台" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock FontSize="13" Margin="0,8,0,0"><Hyperlink NavigateUri="https://github.com/VirtualDrivers/Virtual-Display-Driver" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">Virtual Display Driver</Hyperlink><Run Text=" · 虚拟屏驱动"/></TextBlock>
                        <TextBlock FontSize="13" Margin="0,7,0,0"><Hyperlink NavigateUri="https://github.com/nefarius/nefcon" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">NefCon</Hyperlink><Run Text=" · 设备管理"/></TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Margin="2,14,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"><Hyperlink NavigateUri="https://github.com/zephyr4123/snug/blob/main/LICENSE" RequestNavigate="OpenLink" Foreground="{StaticResource Accent}">MIT 许可</Hyperlink><Run Text=" · 保留原项目版权及历史 · 非 UU远程 官方软件"/></TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>