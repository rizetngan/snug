<Window x:Class="Snug.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snug" Width="540" Height="720" MinWidth="520" MinHeight="700"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="14" Background="#29345C">
                    <TextBlock Text="S" FontSize="27" FontWeight="Bold" Foreground="#DDE3FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Snug" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="WINDOWS" FontSize="9" Foreground="{StaticResource TextMuted}"
                               Margin="1,1,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#17243A" BorderBrush="#2B3C59"
                    BorderThickness="1" CornerRadius="12" Padding="11,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#7D95FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#D8E0F2"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="0,30,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="手机工作区" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DisplayStatus}" Style="{StaticResource MutedText}" Margin="1,5,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="预览" Click="Preview_Click"
                        Padding="13,7" Margin="0,3,0,0"/>
            </DockPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="手机屏" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="连接 UU 后自动创建" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchStyle}"
                                      IsChecked="{Binding PhoneScreenEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </DockPanel>
                    <Separator Margin="0,17" Background="#263650" Height="1"/>
                    <DockPanel LastChildFill="False">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="手机型号" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PhoneChoiceSummary}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="更改" Click="PhoneModel_Click"
                                VerticalAlignment="Center" Padding="14,8"/>
                    </DockPanel>
                    <Separator Margin="0,17" Background="#263650" Height="1"/>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="触控手势" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="滑动、长按与滚动" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchStyle}"
                                      IsChecked="{Binding GesturesEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </DockPanel>
                    <Separator Margin="0,17" Background="#263650" Height="1"/>
                    <DockPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="字号放大" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DefaultZoomSteps, StringFormat={}{0} 级}"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Slider Width="160" Minimum="0" Maximum="5" TickFrequency="1"
                                IsSnapToTickEnabled="True" Value="{Binding DefaultZoomSteps, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel>
                        <TextBlock Text="虚拟显示驱动" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DriverStatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="修复驱动"
                            Click="InstallDriver_Click"
                            IsEnabled="{Binding CanRepairDriver}"
                            VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="开机启动" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="登录 Windows 后在后台运行" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleButton Style="{StaticResource SwitchStyle}"
                                  IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,22,0,0">
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="关于" Click="About_Click" Background="Transparent" BorderBrush="Transparent"/>
                <Button Content="退出 Snug" Click="Exit_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>