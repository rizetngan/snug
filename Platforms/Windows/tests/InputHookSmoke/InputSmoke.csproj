<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup><SnugReplayBuild Condition="'$(SnugReplayBuild)' == ''">..\..\artifacts\release-build</SnugReplayBuild></PropertyGroup>
  <ItemGroup>
    <Reference Include="Snug.Windows"><HintPath>$(SnugReplayBuild)\Snug.Windows.dll</HintPath></Reference>
    <Reference Include="Snug.Windows.Core"><HintPath>$(SnugReplayBuild)\Snug.Windows.Core.dll</HintPath></Reference>
  </ItemGroup>
</Project>